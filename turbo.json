{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "NEXT_PUBLIC_SANITY_*",
        "SANITY_*",
        "TURNSTILE_*",
        "NEXT_PUBLIC_TURNSTILE_*",
        "CONTACT_EMAIL"
      ]
    },
    "lint": {},
    "typecheck": {},
    "dev": { "cache": false, "persistent": true }
  }
}
